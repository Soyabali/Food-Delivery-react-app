# Copy to .env.local if you need to change these. Never put database
# credentials here — the browser app only talks to the FastAPI backend,
# and the backend holds the PostgreSQL connection (mobileapp/backend/.env).

# Where `npm run dev` forwards /api and /media requests.
API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL of the API for production builds. Leave empty when the dashboard
# is served from the same origin as the API (or behind the same proxy).
VITE_API_BASE_URL=
